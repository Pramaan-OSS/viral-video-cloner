{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/execution",
  "credentials": { "local": { "use": "@hypit/credential-store-local" } },
  "endpoints": {
    "images.personal": {
      "use": "@example/provider-images",
      "config": { "baseUrl": "https://images.example", "apiKey": { "store": "local", "key": "images.personal" } }
    },
    "videos.personal": {
      "use": "@example/provider-videos",
      "config": { "baseUrl": "https://videos.example", "apiKey": { "store": "local", "key": "videos.personal" } }
    }
  },
  "bindings": {
    "@hypit/image-family@1#generate": "images.personal",
    "@hypit/video-family@1#generate": "videos.personal"
  }
}
